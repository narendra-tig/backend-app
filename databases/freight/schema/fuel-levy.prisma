enum FuelLevyVersionStatus {
  FUEL_PENDING
  FUEL_ACTIVE
  FUEL_INACTIVE
}

enum FuelLevyType {
  FUEL_SELL
  FUEL_BUY
}

enum FuelLevySellType {
  FUEL_FIXED
  FUEL_MARKUP // percentage
}

enum FuelLevyBuyType {
  FUEL_BUY_FIXED
  FUEL_BUY_MARKUP // percentage
}

model FuelLevy {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  versionIndex           Int
  tenancyCarrierId       String?   @db.Uuid
  accountCarrierId       String?   @db.Uuid
  customerGroupCarrierId String?   @db.Uuid
  tenantId               String    @db.Uuid
  isDefault              Boolean   @default(false)
  codeIndex              Int       @default(autoincrement()) // Auto generated by system
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  carrier                String?
  status                 String?
  currentVersionId       String?
  type                   String?
  startDate              DateTime?
  notes                  String?
  endDate                DateTime?

  versions                     FuelLevyVersion[]
  zones                        Zone[]
  services                     TenancyCarrierService[]
  rateCards                    RateCard[]
  CalculationBreakdownFuelLevy CalculationBreakdownFuelLevy[]

  @@index([tenancyCarrierId], type: Hash)
  @@index([accountCarrierId], type: Hash)
  @@index([isDefault, tenancyCarrierId], name: "fuel_levy_default_tenancy_carrier_index")
}

model FuelLevyVersion {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  code                   String // Auto generated by system
  tenancyCarrierId       String?               @db.Uuid
  accountCarrierId       String?               @db.Uuid
  customerGroupCarrierId String?               @db.Uuid
  rateCardId             String?               @db.Uuid
  buy                    String
  buyType                FuelLevyBuyType?
  sellValue              Float?
  sellType               FuelLevySellType?
  startDate              DateTime
  endDate                DateTime?
  status                 FuelLevyVersionStatus
  type                   FuelLevyType
  notes                  String?
  version                Int
  tenantId               String                @db.Uuid
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt

  fuelLevyId String   @db.Uuid
  fuelLevy   FuelLevy @relation(fields: [fuelLevyId], references: [id], onDelete: Cascade)

  @@index([fuelLevyId], type: Hash)
  @@index([startDate, endDate, status], name: "fuel_levy_version_date_status_index")
  @@index([status, code, startDate, endDate], name: "fuel_levy_version_status_code_date_index")
  @@index([type, status, startDate, endDate], name: "fuel_levy_version_type_status_date_index")
}
