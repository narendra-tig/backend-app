enum SurchargeSellType {
  SURCHARGE_FIXED
  SURCHARGE_MARKUP // percentage
}

enum SurchargeVersionStatus {
  SURCHARGE_PENDING
  SURCHARGE_ACTIVE
  SURCHARGE_INACTIVE
}

enum SurchargeType {
  SURCHARGE_SELL
  SURCHARGE_BUY
}

enum SurchargeBuyType {
  SURCHARGE_BUY_FIXED
  SURCHARGE_BUY_MARKUP // percentage
}

model Surcharge {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  versionIndex           Int
  tenancyCarrierId       String?   @db.Uuid
  accountCarrierId       String?   @db.Uuid
  customerGroupCarrierId String?   @db.Uuid
  tenantId               String    @db.Uuid
  isDefault              Boolean   @default(false)
  codeIndex              Int       @default(autoincrement())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  subCategoryId          String?
  carrier                String?
  status                 String?
  currentVersionId       String?
  type                   String?
  startDate              DateTime?
  notes                  String?
  endDate                DateTime?

  // rules - will be added later

  // surchargeGroup   SurchargeGroup[]
  rules                         Rule[]
  versions                      SurchargeVersion[]
  zones                         Zone[]
  services                      TenancyCarrierService[]
  rateCards                     RateCard[]
  CalculationBreakdownSurcharge CalculationBreakdownSurcharge[]

  @@index([tenancyCarrierId], type: Hash)
  @@index([accountCarrierId], type: Hash)
  @@index([subCategoryId, isDefault, tenancyCarrierId], name: "surcharge_sub_category_default_carrier_index")
}

model SurchargeVersion {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  code                 String // Auto generated by system
  buy                  String
  buyType              SurchargeBuyType?
  sellType             SurchargeSellType?
  sellValue            Float?
  startDate            DateTime
  endDate              DateTime?
  status               SurchargeVersionStatus
  isFuelIncluded       Boolean
  isChargeLevyIncluded Boolean                @default(false)
  type                 SurchargeType
  notes                String?
  version              Int
  tenantId             String                 @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt

  surchargeId String    @db.Uuid
  surcharge   Surcharge @relation(fields: [surchargeId], references: [id], onDelete: Cascade)

  @@index([surchargeId], type: Hash)
  @@index([startDate, endDate, status], name: "surcharge_version_date_status_index")
  @@index([startDate, endDate, status, code], name: "surcharge_version_date_status_code_index")
}

model SurchargeCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  subCategory SurchargeSubCategory[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "surcharge_category_name_trgm_index")
}

model SurchargeSubCategory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  surchargeCategoryId String   @db.Uuid

  category SurchargeCategory @relation(fields: [surchargeCategoryId], references: [id], onDelete: Cascade)

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "surcharge_sub_category_name_trgm_index")
}
