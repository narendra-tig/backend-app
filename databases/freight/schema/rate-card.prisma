enum RateCardType {
  RATECARD_SELL
  RATECARD_BUY
}

enum RateCardStatus {
  RATECARD_ACTIVE
  RATECARD_INACTIVE
}

model RateCard {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  code                   String?
  codeIndex              Int            @default(autoincrement()) // Auto generated by our system
  type                   RateCardType
  startDate              DateTime
  endDate                DateTime?
  status                 RateCardStatus
  tenantId               String         @db.Uuid
  accountId              String?        @db.Uuid
  tenancyCarrierId       String         @db.Uuid
  accountCarrierId       String?        @db.Uuid
  customerGroupCarrierId String?        @db.Uuid
  chargeAccountNumber    String?
  printTemplateId        String?
  carrierAccountNumber   String?
  serviceId              String?        @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz()
  notes                  String?
  customerGroupId        String?        @db.Uuid
  zoneFrom               String?
  zoneTo                 String?

  tenancyCarrier TenancyCarrier @relation(fields: [tenancyCarrierId], references: [id], onDelete: Cascade)

  rateCardLanes                RateCardLane[]
  surcharges                   Surcharge[]
  fuelLevies                   FuelLevy[]
  accountRateCards             RateCardAttachedAccount[]
  CalculationBreakdownRateCard CalculationBreakdownRateCard[]

  @@index([tenancyCarrierId], type: Hash)
  @@index([accountId], type: Hash)
  @@index([tenantId, accountId, tenancyCarrierId, status], name: "rate_card_tenant_account_carrier_status_index")
}

model RateCardLane {
  id                      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service                 String
  shippingCode            String
  from                    String
  to                      String
  isAccumulative          Boolean
  isReciprocal            Boolean
  cubic                   Float
  minCharge               Float
  cubeLimit               Float
  kgLimit                 Float
  round                   Float
  tenantId                String  @db.Uuid
  rateCardId              String  @db.Uuid
  tenacnyCarrierServiceId String  @db.Uuid
  fee                     String?
  fuel                    String?

  rateCardBreaks RateCardPriceBreak[]
  rateCard       RateCard             @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId], type: Hash)
  @@index([from], type: Hash)
  @@index([to], type: Hash)
  @@index([tenacnyCarrierServiceId], type: Hash)
  @@index([rateCardId, service, from, to], name: "rate_card_lane_lookup_index")
}

enum RateCardPriceBreakType {
  RC_BREAK_KG
  RC_BREAK_CUBIC
  RC_BREAK_ITEM
  RC_BREAK_ITEM_AND_KG
  RC_BREAK_KG_BASIC
  PKG
  M3
  ITM
  ARM
  KG
  PM3
}

model RateCardPriceBreak {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  break          Float
  type           RateCardPriceBreakType
  basic          Float
  rate           Float
  tenantId       String                 @db.Uuid
  rateCardLaneId String                 @db.Uuid

  rateCardLane RateCardLane @relation(fields: [rateCardLaneId], references: [id], onDelete: Cascade)

  @@index([rateCardLaneId], type: Hash)
}

model RateCardAttachedAccount {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String    @db.Uuid
  rateCardId String    @db.Uuid
  startDate  DateTime
  endDate    DateTime?
  tenantId   String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt

  rateCards RateCard[]
}

// Buy Sell Rate Card
model CalculationBreakdown {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  serviceId      String?  @db.Uuid
  fromPostCode   String?
  toPostCode     String?
  shipmentId     String?  @db.Uuid
  manifestId     String?  @db.Uuid
  quoteId        String?  @db.Uuid
  surchargePrice Float?
  fuelLevyPrice  Float?
  price          Float?
  currency       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  surchargeDetails CalculationBreakdownSurcharge[]
  fuelLevyDetails  CalculationBreakdownFuelLevy[]
  rateCardDetails  CalculationBreakdownRateCard[]
}

model CalculationBreakdownSurcharge {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @db.Uuid
  calculationBreakdownId String   @db.Uuid
  surchargeId            String   @db.Uuid
  sellValue              Float
  sellType               String
  buyValue               Float
  buyType                String
  ruleIds                String[]
  calculatedCharge       Float
  surchargeDetails       Json

  surcharge            Surcharge            @relation(fields: [surchargeId], references: [id])
  CalculationBreakdown CalculationBreakdown @relation(fields: [calculationBreakdownId], references: [id])
}

model CalculationBreakdownFuelLevy {
  id                     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String @db.Uuid
  calculationBreakdownId String @db.Uuid
  sellValue              Float
  sellType               String
  buyValue               Float
  buyType                String
  calculatedCharge       Float
  fuelLevyId             String @db.Uuid

  fuelLevy             FuelLevy             @relation(fields: [fuelLevyId], references: [id])
  CalculationBreakdown CalculationBreakdown @relation(fields: [calculationBreakdownId], references: [id])
}

model CalculationBreakdownRateCard {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String                 @db.Uuid
  calculationBreakdownId String                 @db.Uuid
  rateCardId             String                 @db.Uuid
  laneId                 String
  priceBreakId           String                 @db.Uuid
  priceBreakType         RateCardPriceBreakType
  rateCardType           RateCardType
  rateCardBuyId          String                 @db.Uuid

  rateCard             RateCard             @relation(fields: [rateCardId], references: [id])
  CalculationBreakdown CalculationBreakdown @relation(fields: [calculationBreakdownId], references: [id])
}
