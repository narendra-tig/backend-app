model DepotContact {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  description String?
  phoneNumber String?
  email       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime? @updatedAt
  tenantId    String    @db.Uuid

  depotId String @db.Uuid
  depot   Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@index([depotId]) // join from Depot
  @@index([depotId, name]) // name filter + join
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "depot_contact_name_trgm_index")
}

model DepotAttachment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName  String?
  reference String?
  size      Int?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  depotId String @db.Uuid
  depot   Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@index([depotId]) // join from Depot
}

model SupplierOfflineDepotLink {
  supplier   SupplierOffline @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String          @db.Uuid
  depot      Depot           @relation(fields: [depotId], references: [id], onDelete: Cascade)
  depotId    String          @db.Uuid
  createdAt  DateTime        @default(now())

  @@id([supplierId, depotId])
}

model SupplierAttachment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName  String?
  reference String?
  size      Int?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  supplierId String          @db.Uuid
  supplier   SupplierOffline @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId]) // join from SupplierOffline
}
