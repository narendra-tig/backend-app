model Depot {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  notes     String?
  sections  Json?
  isStarred Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  depotAttachments DepotAttachment[]
  depotDetails     DepotDetails?
  depotContacts    DepotContact[]
  suppliers        SupplierOfflineDepotLink[]

  @@index([tenantId]) // RLS + tenant filtering
  @@index([tenantId, isStarred]) // starred filter
  @@index([tenantId, name]) // name search/filter
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "depot_name_trgm_index")
}

model DepotDetails {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area         String?
  cutOff       DateTime? @db.Time()
  cutOffAt     DateTime? @db.Timestamptz()
  houseAccount String?
  phoneNumber  String?
  createdAt    DateTime? @default(now()) @db.Timestamptz()
  updatedAt    DateTime? @updatedAt
  tenantId     String    @db.Uuid

  depotId           String             @db.Uuid
  depot             Depot              @relation(fields: [depotId], references: [id], onDelete: Cascade)
  depotServices     DepotService[]
  depotPackageTypes DepotPackageType[]

  @@unique([depotId])
  @@index([depotId])
  @@index([area(ops: raw("gin_trgm_ops"))], type: Gin, name: "depot_details_area_trgm_index")
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], type: Gin, name: "depot_details_phone_number_trgm_index")
}

model DepotService {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
