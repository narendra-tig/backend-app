model SupplierOffline {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  notes     String?
  sections  Json?
  isStarred Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  serviceDetails      ServiceDetails?
  contacts            SupplierContact[]
  tracking            SupplierTracking?
  depots              SupplierOfflineDepotLink[]
  supplierAttachments SupplierAttachment[]

  @@index([tenantId]) // RLS + tenant filtering
  @@index([tenantId, isStarred]) // starred filter
  @@index([tenantId, name]) // name search/filter
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "supplier_offline_name_trgm_index")
}

model ServiceDetails {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area         String?
  cutOff       DateTime? @db.Time()
  cutOffAt     DateTime? @db.Timestamptz()
  houseAccount String?
  phoneNumber  String?
  createdAt    DateTime? @default(now()) @db.Timestamptz()
  updatedAt    DateTime? @updatedAt
  tenantId     String    @db.Uuid

  supplierServices SupplierService[]
  packageTypes     PackageType[]
  supplierId       String            @db.Uuid
  supplier         SupplierOffline   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId])
  @@index([supplierId])
  @@index([area(ops: raw("gin_trgm_ops"))], type: Gin, name: "service_details_area_trgm_index")
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], type: Gin, name: "service_details_phone_number_trgm_index")
}

model SupplierService {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  serviceDetailsId String         @db.Uuid
  serviceDetails   ServiceDetails @relation(fields: [serviceDetailsId], references: [id], onDelete: Cascade)

  @@index([serviceDetailsId]) // join from ServiceDetails
  @@index([serviceDetailsId, name]) // name filter + join
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "supplier_service_name_trgm_index")
}

model PackageType {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime? @updatedAt
  tenantId  String    @db.Uuid

  serviceDetailsId String         @db.Uuid
  serviceDetails   ServiceDetails @relation(fields: [serviceDetailsId], references: [id], onDelete: Cascade)

  @@index([serviceDetailsId]) // join from ServiceDetails
  @@index([serviceDetailsId, name]) // name filter + join
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "package_type_name_trgm_index")
}

model SupplierContact {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
