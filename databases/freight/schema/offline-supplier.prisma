  depotDetails   DepotDetails @relation(fields: [depotDetailsId], references: [id], onDelete: Cascade)

  @@index([depotDetailsId]) // join from DepotDetails
  @@index([depotDetailsId, name]) // name filter + join
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "depot_package_type_name_trgm_index")
