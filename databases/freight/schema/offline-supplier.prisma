  supplier   SupplierOffline @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId]) // join from SupplierOffline
  @@index([supplierId, name]) // name filter + join
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "supplier_contact_name_trgm_index")
