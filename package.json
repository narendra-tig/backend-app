{
  "name": "backend-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "ttsc -p tsconfig.build.json && mkdir -p dist/src/enquiries/proto && cp src/enquiries/proto/enquiries.proto dist/src/enquiries/proto/enquiries.proto",
    "prebuild": "pnpm run nestia:sdk && pnpm run nestia:swagger",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "ttsx -P tsconfig.json src/main.ts",
    "start:dev": "ttsx -P tsconfig.json src/main.ts",
    "start:debug": "node --inspect -r source-map-support/register dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "nestia:sdk": "rimraf api/functional api/structures && nestia sdk",
    "nestia:swagger": "nestia swagger",
    "nestia:e2e": "nestia e2e",
    "nestia:all": "nestia all",
    "sdk:build": "pnpm run nestia:sdk && pnpm exec tsc -p packages/open360-api/tsconfig.json",
    "accounts:generate": "prisma generate --config databases/accounts/prisma.config.ts",
    "core:generate": "prisma generate --config databases/core/prisma.config.ts",
    "documents:generate": "prisma generate --config databases/documents/prisma.config.ts",
    "freight:generate": "prisma generate --config databases/freight/prisma.config.ts",
    "tracking:generate": "prisma generate --config databases/tracking/prisma.config.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestia/core": "^12.1.0",
    "@nestia/fetcher": "^12.1.0",
    "@nestia/sdk": "^12.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typia": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nestia": "^12.1.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "ttsc": "^0.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/../test/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2"
  }
}