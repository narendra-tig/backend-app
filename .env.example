ENV=local
PORT=5000
API_BASE_URL=http://localhost:5000
ACCOUNTS_DATABASE_URL=postgresql://user:password@localhost:port/accounts?schema=public
FREIGHT_DATABASE_URL=postgresql://user:password@localhost:port/freights?schema=public
TRACKING_DATABASE_URL=postgresql://user:password@localhost:port/trackings?schema=public
DOCUMENTS_DATABASE_URL=postgresql://user:password@localhost:port/documents?schema=public
CORE_DATABASE_URL=postgresql://user:password@localhost:port/core?schema=public
TRACKING_ENQUIRIES_SECRET_KEY=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-long-random-service-key
TOKEN_JWT_SECRET=replace-with-session-jwt-secret
TOKEN_JWT_AUDIENCE=open360
HELP_DESK_SERVICE_URL=127.0.0.1:5021
HELP_DESK_GRPC_INSECURE=true
# HELP_DESK_GRPC_CA_PATH=/run/secrets/help-desk-ca.pem
NOTIFICATIONS_TRACKING_URL=http://127.0.0.1:5027/tracking/process